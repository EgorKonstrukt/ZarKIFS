QWidget{background:#000;color:#fff;font:10pt "Consolas";selection-background:#f00;selection-color:#fff}
QMainWindow,QDialog,QScrollArea,QScrollArea>QWidget,QScrollArea>QWidget>QWidget{background:#000;border:none}
QScrollBar:vertical{background:#100;width:8px}
QScrollBar::handle:vertical{background:#f00;min-height:10px}
QScrollBar::handle:vertical:hover{background:#fff}
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical{height:0}
QScrollBar:horizontal{background:#100;height:8px}
QScrollBar::handle:horizontal{background:#f00;min-width:10px}
QScrollBar::handle:horizontal:hover{background:#fff}
QScrollBar::add-line:horizontal,QScrollBar::sub-line:horizontal{width:0}
QGroupBox{border:1px solid #f00;border-radius:0;margin-top:5px;padding-top:5px;background:#000;color:#fff}
QGroupBox::title{subcontrol-origin:margin;left:5px;top:-5px;color:#f00;font-weight:bold}
QPushButton{background:#000;color:#fff;border:1px solid #f00;border-radius:0;padding:2px 8px}
QPushButton:hover{background:#f00;color:#000}
QPushButton:pressed{background:#fff;color:#000}
QPushButton:disabled{color:#500;background:#000;border-color:#500}
QPushButton:checked{background:#f00;color:#000}
QLabel{background:transparent;color:#fff}
QLineEdit,QSpinBox,QDoubleSpinBox,QComboBox{background:#000;color:#fff;border:1px solid #f00;border-radius:0;padding:1px 4px;selection-background:#f00}
QLineEdit:focus,QSpinBox:focus,QDoubleSpinBox:focus,QComboBox:focus{border-color:#fff}
QSpinBox::up-button,QSpinBox::down-button,QDoubleSpinBox::up-button,QDoubleSpinBox::down-button{background:#300;border:none;width:12px}
QSpinBox::up-button:hover,QSpinBox::down-button:hover,QDoubleSpinBox::up-button:hover,QDoubleSpinBox::down-button:hover{background:#f00}
QComboBox::drop-down{border:none;width:16px}
QComboBox QAbstractItemView{background:#000;color:#fff;border:1px solid #f00;selection-background:#f00}
QCheckBox,QRadioButton{color:#fff;spacing:4px;background:transparent}
QCheckBox::indicator,QRadioButton::indicator{width:12px;height:12px;border:1px solid #f00;border-radius:0;background:#000}
QCheckBox::indicator:checked,QRadioButton::indicator:checked{background:#f00;border-color:#f00}
QCheckBox::indicator:hover,QRadioButton::indicator:hover{border-color:#fff}
QSlider::groove:horizontal{height:2px;background:#f00;border-radius:0}
QSlider::handle:horizontal{background:#fff;width:10px;height:10px;margin:-4px 0;border-radius:0}
QSlider::handle:horizontal:hover{background:#f00}
QSlider::sub-page:horizontal{background:#f00;border-radius:0}
QTabWidget::pane{border:1px solid #f00;background:#000}
QTabBar::tab{background:#000;color:#f00;padding:3px 8px;border:1px solid #f00;border-bottom:none;border-top-left-radius:0;border-top-right-radius:0}
QTabBar::tab:selected{background:#000;color:#fff;border-bottom-color:#000}
QTabBar::tab:hover:!selected{background:#300;color:#fff}
QListWidget,QTreeWidget{background:#000;color:#fff;border:1px solid #f00;border-radius:0}
QListWidget::item,QTreeWidget::item{padding:2px 4px;border-bottom:1px solid #300}
QListWidget::item:selected,QTreeWidget::item:selected{background:#f00;color:#000}
QListWidget::item:hover,QTreeWidget::item:hover{background:#300}
QHeaderView::section{background:#000;color:#fff;border:none;border-right:1px solid #f00;padding:2px 4px}
QMenu{background:#000;color:#fff;border:1px solid #f00;padding:1px 0}
QMenu::item{padding:2px 16px}
QMenu::item:selected{background:#f00;color:#000}
QMenu::separator{height:1px;background:#f00;margin:1px 0}
QProgressBar{background:#000;border-radius:0;border:1px solid #f00;text-align:center;color:#fff}
QProgressBar::chunk{background:#f00;border-radius:0}
QToolBar{background:#000;border-bottom:1px solid #f00;spacing:2px;padding:1px 2px}
QToolButton{background:transparent;color:#fff;border:1px solid transparent;border-radius:0;padding:2px 4px;margin:0}
QToolButton:hover{background:#f00;border-color:#fff}
QToolButton:pressed{background:#fff;border-color:#f00}
QToolButton:disabled{color:#500}
QToolButton:checked{background:#000;border-color:#f00;color:#f00}
QStatusBar{background:#000;color:#fff;border-top:1px solid #f00}
QStatusBar QLabel{color:#fff;background:transparent}
QSplitter::handle{background:#f00}
QSplitter::handle:horizontal{width:1px}
QSplitter::handle:vertical{height:1px}
QFrame[frameShape="4"],QFrame[frameShape="5"]{border-color:#f00}
QToolTip{background:#000;color:#fff;border:1px solid #f00;padding:2px;border-radius:0}
QMessageBox,QInputDialog,QFileDialog{background:#000}
QMessageBox QLabel,QInputDialog QLabel,QFileDialog QLabel{color:#fff}
QDialogButtonBox QPushButton{min-width:50px}
